# Copia este archivo como .env y completa los valores reales.
# El .env NO se sube al repositorio (ver .gitignore).

# --- Servidor ---
PORT=4000
NODE_ENV=development
# Zona horaria usada para decidir que es "hoy" y que horarios ya pasaron
TIMEZONE=America/Bogota

# --- Base de datos PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=tu_password
DB_NAME=citas_medicas

# --- Autenticacion (JWT) ---
# Genera cadenas largas y aleatorias, distintas entre entornos.
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=30m

# --- Acceso de invitado (demo) ---
# Permite entrar desde el login sin registrarse, con un usuario "demo" compartido.
# Ponlo en false para desactivarlo.
DEMO_LOGIN_ENABLED=true
DEMO_EMAIL=demo@demo.local
DEMO_PASSWORD=Demo1234

# --- Asistente de voz / IA ---
# rules     -> interprete local por reglas (no necesita claves ni red)
# anthropic -> interpreta con un modelo de Claude (si falla, usa "rules")
ASSISTANT_PROVIDER=rules
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
