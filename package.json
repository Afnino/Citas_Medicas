{
  "name": "citas-medicas",
  "version": "1.0.0",
  "description": "API REST (Node.js + Express + TypeScript + PostgreSQL) para la gestion y programacion de citas medicas, con asistente de voz/IA y autenticacion JWT.",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p .",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p . --noEmit"
  },
  "keywords": [
    "express",
    "typescript",
    "postgresql",
    "typeorm",
    "jwt",
    "hexagonal",
    "citas-medicas"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.17",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
